type = process
command = /bin/sh -c 'for path in /sys/class/net/*; do interface=$$(basename "$$path"); [ "$$interface" = lo ] && continue; /sbin/udhcpc -q -i "$$interface" -p "/run/udhcpc-$$interface.pid" && exit 0; done; exit 1'
depends-on = mdevd-coldplug
depends-on = mount-proc
depends-on = mount-sys
depends-on = mount-runtime
