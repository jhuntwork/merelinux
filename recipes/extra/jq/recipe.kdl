recipe {
    name "jq"
    version "1.8.2"
    release 1
    description "A lightweight and flexible command-line JSON processor"
    url "https://github.com/stedolan/jq"
    licenses "BSD"
    archs "aarch64" "x86_64"
    depends "llvm" "make" "mimalloc-dev" "musl-dev"
}

source "${recipe.url}/releases/download/jq-${recipe.version}/jq-${recipe.version}.tar.gz" {
    blake3 "80f6569efea15b7445aa50fa4e85c4fecb6d5950be788b466b1cb87940af5903"
}

build {
    script r#"
        ./configure \
            --prefix=/usr \
            --enable-static \
            --disable-shared
        make
    "#
}

install {
    script r#"
        make DESTDIR="$DESTDIR" install
    "#
}

package "jq" {
    files "usr/bin/jq" \
          "usr/share/man/man1/"
}

package "jq-dev" {
    files "usr/bin/onig-config" \
          "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
