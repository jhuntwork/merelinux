+endif()
+add_library(glslang ALIAS glslang::glslang)
+add_library(SPIRV ALIAS glslang::SPIRV)
+set(glslang_SOURCE_DIR /usr/include/glslang PARENT_SCOPE)
+set(spirv-tools_SOURCE_DIR /usr PARENT_SCOPE)
+set(SPIRV-Headers_SOURCE_DIR /usr PARENT_SCOPE)
+return()
