+# Installed dependencies have no source-tree CHANGES files or Git metadata.
+# Preserve the shaderc release identity and explicitly identify system libraries.
+file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/CHANGES" shaderc_release
+  REGEX "^v[0-9]+\\.[0-9]+ ")
+list(GET shaderc_release 0 shaderc_release)
+string(REGEX MATCH "v[0-9]+\\.[0-9]+" shaderc_release "${shaderc_release}")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/build-version.inc"
+  "\"shaderc ${shaderc_release}\\n\"\n"
+  "\"spirv-tools system\\n\"\n"
+  "\"glslang system\\n\"\n")
+add_custom_target(build-version)
 
