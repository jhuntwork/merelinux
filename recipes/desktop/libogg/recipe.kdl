recipe {
    name "libogg"
    version "1.3.6"
    release 1
    description "Library for the Ogg multimedia container format"
    url "https://xiph.org"
    archs "aarch64" "x86_64"
    licenses "BSD"
    depends "busybox" \
            "llvm" \
            "make" \
            "mimalloc-dev" \
            "musl-dev"
}

source "http://downloads.xiph.org/releases/ogg/libogg-${recipe.version}.tar.xz" {
    blake3 "ed63da85144c5040cd55143598fac51926db5fc1a46bc80ab3878dd4e5617e92"
}

build {
    script r#"
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-static
        make
    "#
}

install {
    script r#"
        make DESTDIR="${DESTDIR}" install
    "#
}

package "libogg" {
    files "usr/lib/lib*.so*"
}

package "libogg-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/share/aclocal/"
}
