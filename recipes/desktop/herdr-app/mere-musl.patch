 use std::{env, fs, path::PathBuf};
 
 fn main() {
+    // rustc must locate the archive while bundling it into this crate's rlib;
+    // the C linker's default search directories are not sufficient here.
+    println!("cargo:rerun-if-env-changed=LIBUNWIND_LIB_DIR");
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("linux")
+        && env::var("CARGO_CFG_TARGET_ENV").as_deref() == Ok("musl")
+    {
+        let libdir = env::var("LIBUNWIND_LIB_DIR").unwrap_or_else(|_| "/usr/lib".into());
+        println!("cargo:rustc-link-search=native={libdir}");
+    }
     println!("cargo:rustc-check-cfg=cfg(rquickjs_memory_sanitizer)");
     println!("cargo:rustc-check-cfg=cfg(rquickjs_sanitizer)");
     println!("cargo:rerun-if-env-changed=CARGO_CFG_SANITIZE");
