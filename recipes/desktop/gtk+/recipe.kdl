recipe {
    name "gtk+"
    version "3.24.43"
    release 1
    description "The GNOME application development toolkit (GTK3)"
    url "https://www.gtk.org"
    archs "aarch64" "x86_64"
    licenses "LGPL-2.1"
    depends "atk-dev" \
            "cairo-dev" \
            "expat-dev" \
            "fontconfig-dev" \
            "freetype-dev" \
            "fribidi-dev" \
            "gdk-pixbuf" \
            "gdk-pixbuf-dev" \
            "glib-dev" \
            "harfbuzz-dev" \
            "libepoxy-dev" \
            "libffi-dev" \
            "libjpeg-turbo" \
            "libjpeg-turbo-dev" \
            "libpng" \
            "libpng-dev" \
            "libxkbcommon" \
            "libxkbcommon-dev" \
            "linux-headers" \
            "llvm" \
            "mesa-dev" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja" \
            "pango-dev" \
            "pcre2" \
            "pcre2-dev" \
            "pixman-dev" \
            "pkgconf" \
            "python" \
            "shared-mime-info" \
            "wayland" \
            "wayland-dev" \
            "wayland-protocols-dev" \
            "zlib-ng-dev"
}

source "https://download.gnome.org/sources/gtk+/3.24/gtk+-${recipe.version}.tar.xz" {
    blake3 "5feab2bad81e6b5906895f70ddce6227cf96a6a14b16af0ef72c79991a48ddf4"
}

build {
    script r#"
        CC='clang -DEGL_NO_X11=1' \
            meson setup build/ \
            -Dprefix=/usr \
            -Dsysconfdir=/etc \
            -Dbuildtype=release \
            -Ddefault_library=both \
            -Dbroadway_backend=true \
            -Dwayland_backend=true \
            -Dx11_backend=false \
            -Dintrospection=false
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "gtk+" {
    files "etc/gtk-3.0/" \
          "usr/bin/" \
          "usr/lib/gtk-3.0/" \
          "usr/lib/lib*.so*" \
          "usr/share/applications/" \
          "usr/share/glib-2.0/" \
          "usr/share/gtk-3.0/" \
          "usr/share/icons/" \
          "usr/share/themes/"
}

package "gtk+-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/share/aclocal/"
}
