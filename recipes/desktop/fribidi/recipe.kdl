recipe {
    name "fribidi"
    version "1.0.18"
    release 1
    description "The Free Implementation of the Unicode Bidirectional Algorithm"
    url "https://github.com/fribidi/fribidi"
    archs "aarch64" "x86_64"
    licenses "LGPL-2.1"
    depends "llvm" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja"
}

source "https://github.com/fribidi/fribidi/releases/download/v${recipe.version}/fribidi-${recipe.version}.tar.xz" {
    blake3 "b1270c4244a6da13bb18d82b4aff4a413d1ce44cdbd17528931cf9870a7abd64"
}

build {
    script r#"
        meson setup build/ \
            -Dprefix=/usr \
            -Ddefault_library=both \
            -Dtests=false \
            -Ddocs=false
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "fribidi" {
    files "usr/bin/" \
          "usr/lib/lib*.so*"
}

package "fribidi-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
