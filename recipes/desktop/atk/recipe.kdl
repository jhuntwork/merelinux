recipe {
    name "atk"
    version "2.38.0"
    release 1
    description "GNOME accessibility toolkit"
    url "https://www.gnome.org"
    archs "aarch64" "x86_64"
    licenses "LGPL-2.1"
    depends "glib-dev" \
            "libffi-dev" \
            "llvm" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja" \
            "pcre2" \
            "pcre2-dev" \
            "pkgconf"
}

source "https://download.gnome.org/sources/atk/2.38/atk-${recipe.version}.tar.xz" {
    blake3 "cbc1b7ba03009ee5cc0e646d8a86117e0d65bf8d105f2e8714fbde0299a8012e"
}

build {
    script r#"
        meson setup build/ \
            -Dprefix=/usr \
            -Dbuildtype=release \
            -Ddefault_library=both \
            -Dintrospection=false
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "atk" {
    files "usr/lib/lib*.so*"
}

package "atk-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
