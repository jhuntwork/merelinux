recipe {
    name "pango"
    version "1.56.4"
    release 1
    description "Library for laying out and rendering text"
    url "https://pango.gnome.org/"
    archs "aarch64" "x86_64"
    licenses "LGPL-2.1"
    depends "cairo" \
            "cairo-dev" \
            "expat-dev" \
            "fontconfig" \
            "fontconfig-dev" \
            "freetype" \
            "freetype-dev" \
            "fribidi-dev" \
            "glib-dev" \
            "harfbuzz-dev" \
            "libffi-dev" \
            "libpng" \
            "libpng-dev" \
            "llvm" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja" \
            "pcre2" \
            "pcre2-dev" \
            "pixman-dev" \
            "pkgconf" \
            "zlib-ng-dev"
}

source "https://download.gnome.org/sources/pango/1.56/pango-${recipe.version}.tar.xz" {
    blake3 "8042a82f08101c1dabcb337a96035167e3a300de395c57678ce1a133b2dba346"
}

build {
    script r#"
        meson setup build/ \
            -Dprefix=/usr \
            -Dbuildtype=release \
            -Ddefault_library=both \
            -Dintrospection=disabled
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "pango" {
    files "usr/bin/" \
          "usr/lib/lib*.so*"
}

package "pango-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
