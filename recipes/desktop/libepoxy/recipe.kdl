recipe {
    name "libepoxy"
    version "1.5.10"
    release 1
    description "Library for handling OpenGL function pointer management"
    url "https://github.com/anholt/libepoxy"
    archs "aarch64" "x86_64"
    licenses "MIT"
    depends "llvm" \
            "mesa-dev" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja"
}

source "https://github.com/anholt/libepoxy/archive/refs/tags/${recipe.version}.tar.gz" {
    blake3 "df74575d2a4ca65bf98d15ed6357cb066b6369704137e53b5e1d35b6d582657e"
}

build {
    script r#"
        meson setup build/ \
            -Dprefix=/usr \
            -Dbuildtype=release \
            -Ddefault_library=both \
            -Dx11=false
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "libepoxy" {
    files "usr/lib/lib*.so*"
}

package "libepoxy-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
