recipe {
    name "libjpeg-turbo"
    version "3.1.4.1"
    release 1
    description "JPEG image codec with SIMD acceleration"
    url "https://libjpeg-turbo.org/"
    archs "aarch64" "x86_64"
    licenses "BSD"
    depends "cmake" \
            "llvm" \
            "mimalloc-dev" \
            "musl-dev" \
            "nasm" \
            "ninja"
    // Need to figure out arch-specific depends
}

source "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/${recipe.version}/libjpeg-turbo-${recipe.version}.tar.gz" {
    blake3 "0aa89418430b4133a0c861a9b988b86b93e7269fb38329a723a696f8a0a0752d"
}

build {
    script r#"
        export CFLAGS="$CFLAGS -fPIC"
        cmake -B build -G Ninja -Wno-dev \
            -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_INSTALL_DEFAULT_LIBDIR=/usr/lib \
            -DWITH_JPEG8=ON
        cmake --build build
    "#
}

install {
    script r#"
        cmake --install build
    "#
}

package "libjpeg-turbo" {
    files "usr/bin/" \
          "usr/lib/lib*.so*" \
          "usr/share/man/man1/"
}

package "libjpeg-turbo-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/lib/cmake/"
}
