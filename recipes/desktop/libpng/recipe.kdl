recipe {
    name "libpng"
    version "1.6.59"
    release 1
    description "The official PNG reference library"
    url "http://www.libpng.org/pub/png/libpng.html"
    archs "aarch64" "x86_64"
    licenses "PNG"
    depends "llvm" \
            "make" \
            "mimalloc-dev" \
            "musl-dev" \
            "patch" \
            "zlib-ng-dev"
}

source "https://download.sourceforge.net/libpng/libpng-${recipe.version}.tar.xz" {
    blake3 "7a2627a8c2bf0366d136b6232005294a7f681409a8187a64c794965c6268572a"
}

source "https://downloads.sourceforge.net/sourceforge/libpng-apng/libpng-${recipe.version}-apng.patch.gz" {
    blake3 "6d78c2746168452653fd4219002c9e75fc71ad5d4cd01ffbac77d7f295145192"
}

prepare {
    script r#"
        gzip -d "${MERE_SOURCES_DIR}/libpng-${recipe.version}-apng.patch.gz"
        patch -p1 -i "${MERE_SOURCES_DIR}/libpng-${recipe.version}-apng.patch"
    "#
}

build {
    script r#"
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-static
        make
    "#
}

install {
    script r#"
        make DESTDIR="${DESTDIR}" install
    "#
}

package "libpng" {
    files "usr/bin/" \
          "usr/lib/lib*.so*"
}

package "libpng-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/share/man/man3/"
}
