recipe {
    name "libopus"
    version "1.6.1"
    release 1
    description "Versatile open audio codec"
    url "https://www.opus-codec.org/"
    archs "aarch64" "x86_64"
    licenses "BSD"
    depends "busybox" \
            "llvm" \
            "make" \
            "mimalloc-dev" \
            "musl-dev"
}

source "http://downloads.xiph.org/releases/opus/opus-${recipe.version}.tar.gz" {
    blake3 "874bd7d28e24f10d88105c7d846a2e5bf085284af91a0ee36b05674a8f78e759"
}

build {
    script r#"
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-static
        make
    "#
}

install {
    script r#"
        make DESTDIR="${DESTDIR}" install
    "#
}

package "libopus" {
    files "usr/lib/lib*.so*"
}

package "libopus-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/share/aclocal/"
}
