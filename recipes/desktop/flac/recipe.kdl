recipe {
    name "flac"
    version "1.5.0"
    release 1
    description "Free Lossless Audio Codec library"
    url "https://xiph.org/flac/"
    archs "aarch64" "x86_64"
    licenses "BSD"
    depends "busybox" \
            "libogg-dev" \
            "llvm" \
            "make" \
            "mimalloc-dev" \
            "musl-dev"
}

source "http://downloads.xiph.org/releases/flac/flac-${recipe.version}.tar.xz" {
    blake3 "2adca3cd8da4b577ebb9c12e73c91cf6f6a7feb7485b3f003853b82710bada84"
}

build {
    script r#"
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-static
        make
    "#
}

install {
    script r#"
        make DESTDIR="${DESTDIR}" install
    "#
}

package "flac" {
    files "usr/bin/" \
          "usr/lib/lib*.so*" \
          "usr/share/man/man1/"
}

package "flac-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/" \
          "usr/share/aclocal/"
}
