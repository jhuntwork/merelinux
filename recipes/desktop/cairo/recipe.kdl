recipe {
    name "cairo"
    version "1.18.4"
    release 3
    description "2D graphics library with support for multiple output devices"
    url "https://cairographics.org/"
    archs "aarch64" "x86_64"
    licenses "LGPL-2.1"
    depends "expat-dev" \
            "fontconfig" \
            "fontconfig-dev" \
            "freetype" \
            "freetype-dev" \
            "glib-dev" \
            "harfbuzz" \
            "harfbuzz-dev" \
            "libffi-dev" \
            "libpng" \
            "libpng-dev" \
            "llvm" \
            "meson" \
            "mimalloc-dev" \
            "musl-dev" \
            "ninja" \
            "pcre2" \
            "pcre2-dev" \
            "pkgconf" \
            "pixman-dev" \
            "zlib-ng-dev"
}

source "https://cairographics.org/releases/cairo-${recipe.version}.tar.xz" {
    blake3 "b9fa14e02f85ec4e72396c62236c98502d04dbbdf8daf01ab9557a1c7aa7106e"
}

build {
    script r#"
        meson setup build/ \
            -Dprefix=/usr \
            -Dbuildtype=release \
            -Ddefault_library=both \
            -Dtests=disabled
        ninja -C build/
    "#
}

install {
    script r#"
        ninja -C build/ install
    "#
}

package "cairo" {
    files "usr/bin/" \
          "usr/lib/lib*.so*" \
          "usr/lib/cairo/"
}

package "cairo-dev" {
    files "usr/include/" \
          "usr/lib/lib*.a" \
          "usr/lib/pkgconfig/"
}
