recipe {
    name "guest-lifecycle"
    version "1.0"
    release 2
    description "Disposable service lifecycle fixture"
    url "https://merelinux.org"
    licenses "MIT"
    archs "x86_64"
    depends "busybox"
}
source "daemon" {
    blake3 "fe19fd7f2fc33d21f830c1f549298e8d0e722e211bc9d30b976a6d20f36ec07b"
}
install {
    script r#"
        mkdir -p "${DESTDIR}/usr/libexec" "${DESTDIR}/etc"
        cp "${MERE_SOURCES_DIR}/daemon" "${DESTDIR}/usr/libexec/guest-lifecycle"
        chmod 0755 "${DESTDIR}/usr/libexec/guest-lifecycle"
        printf 'v2\n' > "${DESTDIR}/etc/guest-lifecycle.conf"
    "#
}
package "guest-lifecycle" {
    files "usr/" "etc/"
    service "guest-lifecycle" {
        type "daemon"
        command "/usr/libexec/guest-lifecycle" "v2"
        log true
        depends-on "sysinit"
    }
    service "guest-essential" {
        type "oneshot"
        up "/usr/libexec/guest-lifecycle" "essential"
        essential true
        log false
    }
    service "guest-override" {
        type "oneshot"
        up "/bin/true"
        log false
    }
    service "guest-new" {
        type "oneshot"
        up "/bin/true"
        log false
    }
}
