#!/bin/sh
set -eux
export PATH=/opt:/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
cd /
/bin/sh /etc/boot-test/check
service=guest-lifecycle
native=/usr/share/dinit.d/$service
status() {
    mere --no-color status "$service" > /run/lifecycle-status 2>&1
    cat /run/lifecycle-status
    grep -q "OnBoot: $1" /run/lifecycle-status
    mere --no-color status > /run/lifecycle-list 2>&1
    cat /run/lifecycle-list
    grep -q "^guest-lifecycle[[:space:]].*[[:space:]]$1$" /run/lifecycle-list
}
stopped() {
    if dinitctl is-started "$service"; then
        printf 'Service unexpectedly running\n' >&2
        exit 1
    fi
}
pid_changed() {
    attempts=0
    while [ ! -s /run/guest-lifecycle.pid ] || [ "$(cat /run/guest-lifecycle.pid)" = "$1" ]; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ]
        sleep 0.1
    done
}
if [ "$1" != 0 ]; then
    gen=$(cat /var/log/lifecycle-v1-generation)
    [ "$(readlink /mere/profiles/system/current)" = "gen-$gen" ]
    grep -qx admin-owned /etc/guest-lifecycle.conf
    cmp /etc/dinit.d/guest-override /var/log/lifecycle-admin-service
fi
refused() {
    before=$(readlink /mere/profiles/system/current)
    if "$@" > /run/transaction-rejected 2>&1; then
        cat /run/transaction-rejected
        printf 'Unsafe transition unexpectedly succeeded\n' >&2
        exit 1
    fi
    cat /run/transaction-rejected
    grep -q "is active; stop it" /run/transaction-rejected
    [ "$(readlink /mere/profiles/system/current)" = "$before" ]
    dinitctl is-started "$service"
}
case $1 in
0)
    mere dev key generate
    fingerprint_output=$(mere --no-color dev key fingerprint /root/.mere/keys/mere.pub)
    fingerprint=${fingerprint_output##*: }
    [ "${#fingerprint}" -eq 64 ]
    cp /root/.mere/keys/mere.pub /mere/keys/lifecycle.pub
    # Each version is built from its own recipe and imported only when needed.
    mere dev build --no-cache /etc/lifecycle/v1/recipe.kdl
    set -- /mere/dev/build/guest-lifecycle-1.0-1-*/pkg/guest-lifecycle-1.0-1-*.pkg.tar.zst
    [ "$#" -eq 1 ] && [ -f "$1" ]
    mere dev import lifecycle "$1"
    printf '\nrepo "lifecycle" {\n url "file:///mere/dev/repo/lifecycle"\n priority 200\n trusted-fingerprints "%s"\n}\n' "$fingerprint" >> /mere/config.kdl
    # Build the new boot default, then explicitly adopt it in this disposable VM.
    mere dev build --no-cache /etc/lifecycle/boot-package/recipe.kdl
    set -- /mere/dev/build/mere-boot-0.1.0-2-*/pkg/mere-boot-0.1.0-2-*.pkg.tar.zst
    [ "$#" -eq 1 ] && [ -f "$1" ]
    mere dev import lifecycle "$1"
    mere upgrade --sync mere-boot
    mere etc apply /etc/dinit.d/boot
    grep -q 'depends-on.d = /usr/share/dinit.d/mere-essential.d' /etc/dinit.d/boot
    dinit-check -d /etc/dinit.d -d /usr/share/dinit.d boot
    absent=$(readlink /mere/profiles/system/current)
    absent=${absent#gen-}
    mere install -p system guest-lifecycle
    [ ! -e /run/guest-essential.started ]
    if mere disable guest-essential > /run/essential-disable 2>&1; then exit 1; fi
    grep -q 'essential boot services cannot be disabled' /run/essential-disable
    mere --no-color status > /run/essential-status
    grep -q '^guest-essential[[:space:]].*essential$' /run/essential-status
    gen=$(readlink /mere/profiles/system/current)
    gen=${gen#gen-}
    printf '%s\n' "$gen" > /var/log/lifecycle-v1-generation
    grep -q 'v1' "$native"
    [ -f /usr/share/dinit.d/guest-old ]
    [ ! -e /usr/share/dinit.d/guest-new ]
    printf 'admin-owned\n' > /etc/guest-lifecycle.conf
    printf 'type = scripted\ncommand = /bin/false\n' > /etc/dinit.d/guest-override
    cp /etc/dinit.d/guest-override /var/log/lifecycle-admin-service
    mere start "$service"
    pid_changed ''
    first=$(cat /run/guest-lifecycle.pid)
    # Loss of the live control channel must not be mistaken for a stopped service.
    before=$(readlink /mere/profiles/system/current)
    mv /run/dinitctl /run/dinitctl.saved
    if mere uninstall guest-lifecycle > /run/control-unavailable 2>&1; then
        accepted=1
    else
        accepted=0
    fi
    mv /run/dinitctl.saved /run/dinitctl
    [ "$accepted" -eq 0 ]
    grep -q 'cannot inspect live services' /run/control-unavailable
    [ "$(readlink /mere/profiles/system/current)" = "$before" ]
    refused mere store generation activate "$absent"
    mere dev build --no-cache /etc/lifecycle/v2/recipe.kdl
    set -- /mere/dev/build/guest-lifecycle-1.0-2-*/pkg/guest-lifecycle-1.0-2-*.pkg.tar.zst
    [ "$#" -eq 1 ] && [ -f "$1" ]
    mere dev import lifecycle "$1"
    mere upgrade --sync guest-lifecycle
    newer=$(readlink /mere/profiles/system/current)
    newer=${newer#gen-}
    grep -q 'v2' "$native"
    [ ! -e /usr/share/dinit.d/guest-old ]
    [ -f /usr/share/dinit.d/guest-new ]
    grep -qx admin-owned /etc/guest-lifecycle.conf
    cmp /etc/dinit.d/guest-override /var/log/lifecycle-admin-service
    [ "$(cat /run/guest-lifecycle.pid)" = "$first" ]
    grep -qx v1 /run/guest-lifecycle.version
    mere restart "$service"
    pid_changed "$first"
    grep -qx v2 /run/guest-lifecycle.version
    first=$(cat /run/guest-lifecycle.pid)
    refused mere uninstall guest-lifecycle
    mere store generation activate "$gen"
    [ "$(cat /run/guest-lifecycle.pid)" = "$first" ]
    grep -qx v2 /run/guest-lifecycle.version
    mere restart "$service"
    pid_changed "$first"
    grep -qx v1 /run/guest-lifecycle.version
    # Invalid administrator descriptions fail refresh before disrupting the process.
    first=$(cat /run/guest-lifecycle.pid)
    printf 'type = invalid\n' > /etc/dinit.d/guest-lifecycle
    if mere restart "$service"; then exit 1; fi
    [ "$(cat /run/guest-lifecycle.pid)" = "$first" ]
    rm /etc/dinit.d/guest-lifecycle
    mere stop "$service"
    # A stopped but still-loaded service must also adopt the active description.
    mere store generation activate "$newer"
    mere start "$service"
    pid_changed ''
    grep -qx v2 /run/guest-lifecycle.version
    mere stop "$service"
    mere store generation activate "$gen"
    mere start "$service"
    pid_changed ''
    grep -qx v1 /run/guest-lifecycle.version
    mere stop "$service"
    dinitctl unload "$service"
    mere uninstall guest-lifecycle
    for name in guest-lifecycle guest-override guest-new guest-old; do
        [ ! -e "/usr/share/dinit.d/$name" ]
    done
    cmp /etc/dinit.d/guest-override /var/log/lifecycle-admin-service
    mere store generation activate "$gen"
    grep -q 'v1' "$native"
    [ -f /usr/share/dinit.d/guest-old ]
    [ ! -e /usr/share/dinit.d/guest-new ]
    cmp /etc/dinit.d/guest-override /var/log/lifecycle-admin-service
    grep -qx admin-owned /etc/guest-lifecycle.conf
    printf 'MERE_%s_PASS\n' PACKAGE_LIFECYCLE
    # The adapter must separate boot intent from current process state.
    mere start "$service"
    pid_changed ''
    first=$(cat /run/guest-lifecycle.pid)
    status disabled
    grep -qx v1 /run/guest-lifecycle.version
    mere reload "$service"
    attempts=0
    while [ ! -f /run/guest-lifecycle.reload ]; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ]
        sleep 0.1
    done
    [ "$(cat /run/guest-lifecycle.pid)" = "$first" ]
    mere restart "$service"
    pid_changed "$first"
    mere logs "$service" > /run/lifecycle-logs 2>&1
    cat /run/lifecycle-logs
    grep -q 'guest-lifecycle v1 started' /run/lifecycle-logs
    mere stop "$service"
    stopped
    status disabled
    mere enable "$service"
    stopped
    [ -L /etc/dinit.d/boot.d/guest-lifecycle ]
    status enabled
    mere start "$service"
    pid_changed ''
    first=$(cat /run/guest-lifecycle.pid)
    mere disable "$service"
    dinitctl is-started "$service"
    [ "$(cat /run/guest-lifecycle.pid)" = "$first" ]
    status disabled
    [ ! -L /etc/dinit.d/boot.d/guest-lifecycle ]
    mere stop "$service"
    stopped
    mere enable "$service"
    stopped
    printf 'MERE_%s_PASS\n' SERVICE_LIFECYCLE
    ;;
1)
    # Essential metadata and optional enable both take effect at next boot.
    dinitctl is-started guest-essential
    [ -f /run/guest-essential.started ]
    dinitctl is-started "$service"
    status enabled
    mere disable "$service"
    dinitctl is-started "$service"
    status disabled
    printf 'MERE_%s_PASS\n' ENABLED_BOOT
    ;;
2)
    # Disable persisted without stopping the previous boot's live process.
    stopped
    [ ! -L /etc/dinit.d/boot.d/guest-lifecycle ]
    grep -q 'v1' "$native"
    dinitctl is-started guest-essential
    [ -f /run/guest-essential.started ]
    mere --no-color status guest-essential > /run/essential-status 2>&1
    grep -q 'OnBoot: essential' /run/essential-status
    if mere disable guest-essential; then exit 1; fi
    printf 'MERE_%s_PASS\n' DISABLED_BOOT
    # The next boot must fail through a hard dependency and offer authenticated recovery.
    rm /etc/dinit.d/boot.d/boot-test-lifetime
    printf 'type = scripted\ncommand = /bin/false\n' > /etc/dinit.d/guest-essential
    ;;
*) exit 2 ;;
esac
