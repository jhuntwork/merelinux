#!/bin/sh
# Prepare and boot a disposable Mere root with dinit as PID 1.
set -eu
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    printf 'Usage: %s ABSOLUTE_MERE_BINARY NEW_ABSOLUTE_RESULTS [PREVIOUS_INPUTS_DIR]\n' "$0" >&2
    exit 2
fi
mere=$1
results=$2
previous=${3:-}
case $results in /*) ;; *) printf 'Results path must be absolute\n' >&2; exit 2 ;; esac
qemu=${QEMU:-qemu-system-x86_64}
for tool in "$qemu" mktemp mkdir cp readlink truncate mke2fs timeout find chmod rm grep cat mv dirname; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Missing host utility: %s\n' "$tool" >&2
        exit 2
    fi
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Refuse existing results so a previous run cannot supply a success marker.
mkdir "$results"
work=$(mktemp -d)
cleanup() {
    # Store directories retain read-only modes. Change only the disposable
    # tree's directories; never follow its absolute store symlinks.
    find "$work" -type d -exec chmod u+w {} +
    rm -rf "$work"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
root=$work/root
if [ -n "$previous" ]; then
    if ! sh "$script_dir/prepare-root" "$mere" "$root" "$previous" > "$results/setup.log" 2>&1; then
        cat "$results/setup.log"
        exit 1
    fi
else
    if ! sh "$script_dir/prepare-root" "$mere" "$root" > "$results/setup.log" 2>&1; then
        cat "$results/setup.log"
        exit 1
    fi
fi
cat "$results/setup.log"
mv "$root/test-inputs" "$results/inputs"
profile=$root/mere/profiles/guest/root
mkdir -p "$root/mere" "$root/etc/dinit.d" "$root/proc" "$root/sys" \
    "$root/dev" "$root/home" "$root/run" "$root/tmp" "$root/var/log"
for dir in bin sbin usr lib boot; do
    if [ -d "$profile/$dir" ]; then
        cp -RPp "$profile/$dir" "$root/"
    fi
done
# Resolve the kernel's logical symlink against this guest's store, not the host.
kernel_target=$(readlink "$root/boot/vmlinux")
case $kernel_target in
    /mere/store/*) kernel=$root$kernel_target ;;
    *) printf 'Expected a logical store link for boot/vmlinux\n' >&2; exit 2 ;;
esac
[ -r "$kernel" ]
: > "$root/etc/fstab"
cat > "$root/etc/dinit.d/boot" <<'SERVICE'
type = internal
depends-on = shutdown-probe
SERVICE
cat > "$root/etc/dinit.d/probe" <<'SERVICE'
type = scripted
command = /bin/sh /etc/guest-probe
options = starts-on-console
SERVICE
cat > "$root/etc/dinit.d/shutdown-probe" <<'SERVICE'
type = process
command = /bin/sh /etc/shutdown-probe
depends-on = probe
options = starts-on-console
restart = false
SERVICE
cat > "$root/etc/guest-probe" <<'GUEST'
#!/bin/sh
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
printf 'MERE_KERNEL: '; uname -r
printf 'PID1: '; cat /proc/1/comm
[ "$(cat /proc/1/comm)" = dinit ]
printf 'ROOT: '; mount | grep ' on / '
printf 'DINIT_BOOT_PASS\n'
sync
GUEST
cat > "$root/etc/shutdown-probe" <<'GUEST'
#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
printf 'SHUTDOWN_PROBE_START\n'
sleep 1
exec shutdown -p
GUEST
if [ "${MERE_GUEST_TESTS:-0}" = 1 ]; then
    sh "$script_dir/prepare-mere-tests" "$mere" "$root" "$results"
fi
truncate -s "${QEMU_DISK_SIZE:-384M}" "$work/root.ext4"
mke2fs -q -t ext4 -F -d "$root" "$work/root.ext4"
timeout "${QEMU_TIMEOUT:-120}" "$qemu" \
    -accel tcg,thread=single -m 256 -smp 1 -nodefaults \
    -display none -serial stdio -monitor none -no-reboot \
    -kernel "$kernel" -drive "file=$work/root.ext4,format=raw,if=ide" \
    -append 'console=ttyS0 root=/dev/sda rootfstype=ext4 rw init=/bin/dinit panic=-1' \
    > "$results/serial.log" 2>&1 || {
        cat "$results/serial.log"
        exit 1
    }
cat "$results/serial.log"
grep -q '^DINIT_BOOT_PASS' "$results/serial.log"
grep -q 'Issuing shutdown via kernel' "$results/serial.log"
grep -q 'reboot: Power down' "$results/serial.log"
if [ "${MERE_GUEST_TESTS:-0}" = 1 ]; then
    for marker in MERE_SHELL_PASS MERE_BUILD_SCRIPT_PASS MERE_ARCHIVE_PASS MERE_FAILURE_PASS MERE_GUEST_TESTS_PASS; do
        grep -q "^$marker" "$results/serial.log"
    done
fi
